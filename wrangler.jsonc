{
  // Cloudflare Workers 静态资源托管。
  // Worker 名字要和面板里建的那个对上（面板 URL 里是 /services/view/cat/）。
  "name": "cat",
  "compatibility_date": "2026-08-25",

  // 站点内容由 cf-build.sh 组装到 _site/。
  // 之所以不直接指向仓库根：image/ 有一千多张原始立绘、约 1.4 GB，
  // 站点一个字节都不读，不挑出来每次部署都要传。
  "assets": {
    "directory": "./_site",

    // 找不到的路径原样返回 404，不要当单页应用往 index.html 兜。
    // 根路径 / 的重写交给 _site/_redirects 那一行处理。
    "not_found_handling": "none",

    // 带扩展名的地址不自动跳到去掉扩展名的形式，
    // 主文档就是 .../156a50943028.html，跳了就取不到。
    "html_handling": "none"
  }
}
